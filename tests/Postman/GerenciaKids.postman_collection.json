        {
          "name": "Logout (Revoga Todos os Tokens ?all=true)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/auth/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ email: 'responsavel@ifsul.edu.br', senha: '123456' }) }",
                  "}, (err, res) => {",
                  "    if (!err && res) {",
                  "        const json = res.json();",
                  "        const t = json.data?.access_token ?? json.access_token;",
                  "        if (t) pm.collectionVariables.set('token', t);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"],
              "query": [
                {
                  "key": "all",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        }
