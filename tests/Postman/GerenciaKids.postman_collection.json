          "response": []
        },
        {
          "name": "Logout (Revoga Token Atual)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        },
        {
          "name": "Logout (Revoga Todos os Tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"],
              "query": [
                {
                  "key": "all",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        }
